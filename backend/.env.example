# Kopier til .env og fyll inn. .env pushes aldri (gitignorert).
# Produksjonsverdiene settes i Railway → backend-tjenesten → Variables.

# ─── Database ────────────────────────────────────────────────────────────────
# Produksjon: Supabase (bruk Session mode / pooler – se README).
# Lokalt kan du bruke: sqlite:///./local.db
DATABASE_URL=postgresql://bruker:passord@host:5432/postgres

# ─── Vipps ───────────────────────────────────────────────────────────────────
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_ENV=prod            # prod eller test
VIPPS_WEBHOOK_SECRET=     # samme verdi som i Vipps Merchant Portal

# ─── URL-er ──────────────────────────────────────────────────────────────────
BASE_URL=https://innocents-backend-production.up.railway.app
FRONTEND_RETURN_URL=https://billetter.innocents.no
CORS_ORIGINS=https://innocents.no,https://billetter.innocents.no

# ─── Kampanjepris ────────────────────────────────────────────────────────────
# Når lanseringsprisen går ut. Uten tidssone tolkes det som norsk tid.
# Tom verdi = ingen kampanjepris, kun ordinær pris.
CAMPAIGN_ENDS_AT=2026-09-01T00:00:00+02:00
CAMPAIGN_LABEL=Lanseringspris

# ─── E-post (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=billetter@innocents.no
ADMIN_NOTIFICATION_EMAIL=post@pixlmedia.no,post@innocents.no
